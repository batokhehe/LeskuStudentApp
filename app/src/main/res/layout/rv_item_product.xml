<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:app="http://schemas.android.com/apk/res-auto">
    <data>
        <import type="android.view.View" />
        <variable
            name="product"
            type="id.co.lesku.viewmodels.ProductViewModel"/>
        <variable name="productlist"
            type="id.co.lesku.viewmodels.ProductListViewModel"/>
    </data>
    <android.support.v7.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="10dip"
        android:elevation="4dp"
        android:background="@drawable/shape_rect"
        android:foreground="?attr/selectableItemBackground">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <ImageView
                android:id="@+id/productCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:adjustViewBounds="true"
                android:scaleType="fitXY"
                app:imageProductUrl="@{product.image}"/>

            <TextView
                android:id="@+id/productName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentLeft="true"
                android:layout_below="@+id/productCard"
                android:layout_margin="@dimen/activity_horizontal_margin"
                android:textStyle="bold"
                android:textAppearance="?android:attr/textAppearanceSmall"
                android:text="@{product.name}" />

            <TextView
                android:id="@+id/productDesc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@{product.description}"
                android:paddingLeft="5dip"
                android:ellipsize="end"
                android:maxLines="1"/>

            <!--<ImageView-->
                <!--android:id="@+id/productDetail"-->
                <!--android:layout_width="wrap_content"-->
                <!--android:layout_height="wrap_content"-->
                <!--android:layout_alignParentRight="true"-->
                <!--android:layout_above="@+id/productDesc"-->
                <!--android:src="@drawable/ic_dots"/>-->

        </RelativeLayout>
    </android.support.v7.widget.CardView>
</layout>