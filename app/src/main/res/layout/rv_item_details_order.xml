<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:app="http://schemas.android.com/apk/res-auto">
    <data>
        <import type="android.view.View" />
        <variable
            name="detailsOrder"
            type="id.co.lesku.viewmodels.DetailsOrderViewModel"/>
    </data>
    <android.support.v7.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="5dip"
        android:foreground="?attr/selectableItemBackground">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:padding="5dip"
            android:weightSum="1">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="0.6"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/detailsOrderName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@{detailsOrder.subjectName}" />

                <TextView
                    android:id="@+id/detailsOrderStudyStartAt"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@{detailsOrder.studyStartAt}"
                    android:paddingLeft="5dip"/>

            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="0.4"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/detailsOrderImage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scaleType="fitXY"
                    app:imageTeacherUrl="@{detailsOrder.teacherImage}"/>

                <TextView
                    android:id="@+id/detailsOrderTeacherName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@{detailsOrder.teacherName}"/>

            </LinearLayout>

        </LinearLayout>

    </android.support.v7.widget.CardView>

</layout>