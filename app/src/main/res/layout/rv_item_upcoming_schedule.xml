<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:app="http://schemas.android.com/apk/res-auto">
    <data>
        <import type="android.view.View" />
        <variable
            name="upcomingSchedule"
            type="com.lescepat.viewmodels.UpcomingScheduleViewModel"/>
    </data>
    <androidx.cardview.widget.CardView
        xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="5dip"
        app:cardElevation="5dp"
        app:cardCornerRadius="10dp"
        android:foreground="?attr/selectableItemBackground">

        <TextView
            android:id="@+id/upcomingScheduleId"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:text="@{upcomingSchedule.id}" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:padding="5dip"
                android:weightSum="1">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="0.6"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/upcomingScheduleSubjectName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingLeft="@dimen/activity_horizontal_margin"
                        android:paddingTop="@dimen/activity_horizontal_margin"
                        android:gravity="center_horizontal"
                        android:textStyle="bold"
                        android:textAppearance="?android:attr/textAppearanceMedium"
                        android:text="@{upcomingSchedule.subjectName}" />

                    <View
                        style="@style/Divider"
                        android:layout_margin="5dp"/>

                    <TextView
                        android:id="@+id/upcomingScheduleStudyStartAt"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:layout_marginBottom="5dp"
                        android:gravity="center_horizontal"
                        android:textAppearance="?android:attr/textAppearanceMedium"
                        android:text="@{upcomingSchedule.studyStartAt}"
                        android:paddingLeft="5dip"/>

                    <TextView
                        android:id="@+id/tv_detail_order_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:layout_gravity="center_horizontal"
                        android:padding="5dp"
                        android:textAppearance="?android:attr/textAppearanceSmall"
                        android:textColor="@{upcomingSchedule.getStatus == 0 || upcomingSchedule.getStatus == 3 ? @color/red : @color/green}"
                        android:background="@{upcomingSchedule.getStatus == 0 || upcomingSchedule.getStatus == 3 ? @drawable/shape_rect_button_red_outline : @drawable/shape_rect_button_green_outline}"
                        android:text="@{upcomingSchedule.getStatusText}"
                        android:paddingLeft="5dip"/>

                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="0.4"
                    android:orientation="vertical"
                    android:gravity="center">

                    <ImageView
                        android:id="@+id/upcomingScheduleteacherImage"
                        android:layout_width="120dp"
                        android:layout_height="120dp"
                        android:layout_gravity="center"
                        android:scaleType="fitXY"
                        app:imageTeacherUrl="@{upcomingSchedule.teacherImage}"/>

                    <TextView
                        android:id="@+id/upcomingScheduleteacherName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:gravity="center_horizontal"
                        android:textAppearance="?android:attr/textAppearanceSmall"
                        android:text="@{upcomingSchedule.teacherName}" />

                    <TextView
                        android:id="@+id/upcomingScheduleteacherAddress"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:visibility="gone"
                        android:textAppearance="?android:attr/textAppearanceSmall"
                        android:text="@{upcomingSchedule.teacherAddress}" />

                </LinearLayout>

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:weightSum="1"
                android:orientation="horizontal"
                android:visibility="@{upcomingSchedule.studentStatus == 0 ? View.GONE : View.VISIBLE}">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.5"
                    android:layout_margin="@dimen/activity_horizontal_margin"
                    android:padding="5dp"
                    android:gravity="center_horizontal"
                    android:textAppearance="?android:attr/textAppearanceSmall"
                    android:text="@{upcomingSchedule.getStatusText}"
                    android:textColor="@color/colorPrimaryDark"
                    android:background="@drawable/shape_rect_button_green_outline"/>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.5"
                    android:layout_margin="@dimen/activity_horizontal_margin"
                    android:padding="5dp"
                    android:gravity="center_horizontal"
                    android:textAppearance="?android:attr/textAppearanceSmall"
                    android:text="@{upcomingSchedule.getUniqueCode}"
                    android:textColor="@color/black"
                    android:background="@drawable/shape_rect_button_black_outline"
                    android:visibility="@{upcomingSchedule.studentStatus == 4 ? View.VISIBLE : View.GONE}"/>

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:weightSum="1"
                android:orientation="horizontal"
                android:visibility="@{upcomingSchedule.studentStatus == 0 ? View.VISIBLE : View.GONE}">

                <Button
                    android:id="@+id/btn_confirm_Schedule"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.5"
                    android:layout_margin="@dimen/activity_horizontal_margin"
                    android:background="@drawable/shape_rect_button_green"
                    android:text="@string/confirm"
                    android:textColor="@color/white"/>

                <Button
                    android:id="@+id/btn_reschedule_Schedule"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.5"
                    android:layout_margin="@dimen/activity_horizontal_margin"
                    android:background="@drawable/shape_rect_button_red"
                    android:text="@string/reschedule"
                    android:textColor="@color/white"/>

            </LinearLayout>

        </LinearLayout>

    </androidx.cardview.widget.CardView>

</layout>